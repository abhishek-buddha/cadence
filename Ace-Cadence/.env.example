# Copy to .env and fill in real values. docker-compose reads this file
# automatically; every service's Settings also loads it directly (see
# base-image/common/config.py) for local (non-Compose) runs.

# MySQL is installed natively on the EC2 host, not containerized — every
# container reaches it via host.docker.internal, not localhost.
DATABASE_URL=mysql+asyncmy://cadence:changeme@host.docker.internal:3306/cadence

LOG_LEVEL=INFO

# login-svc
ACCESS_CODE=472394

# call-handling-svc / telephony-bridge-svc
OPENAI_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
ELEVENLABS_API_KEY=
